NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Legacy alias still works:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# Server-only. Never use NEXT_PUBLIC_ for service credentials.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=https://your-production-domain.example

# Payment operations (apply database/04_payment_operations.sql)
# Set a long random server secret; your scheduler must send Authorization: <secret>
CRON_SECRET=
# Manual evidence reviews stay disabled until your approved verification process exists.
VERIFICATION_REVIEW_ENABLED=false

# Approved manual deposit and withdrawal channels
# Apply database/46_manual_deposit_private_receipts.sql before using private deposit screenshots.
MANUAL_GCASH_DEPOSITS_ENABLED=false
MANUAL_PALAWAN_DEPOSITS_ENABLED=false
# Required before enabling manual GCash deposits; use the approved local merchant QR asset.
MANUAL_GCASH_QR_IMAGE=
MANUAL_GCASH_MERCHANT_NAME=
MANUAL_GCASH_INSTRUCTIONS=
MANUAL_GOTYME_WITHDRAWALS_ENABLED=false

# Separate manually reconciled PalawanPay and GoTyme cash ledgers.
MANUAL_TREASURY_ENABLED=false
